# API reads apps/api/.env; defaults work without copying this file.
DATABASE_URL=file:./dev.db
REGISTRATION_ENABLED=true
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Required when running seed (development only).
# 仅限本地开发灌演示数据使用；生产环境登录已显式拒绝该密码，
# 注册与改密接口也会拒绝任何含 "kingflow" 的密码。
DEMO_PASSWORD=KingFlow@2026
